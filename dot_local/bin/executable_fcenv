#!/bin/bash

# Check that the script is sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "Error: Please source this script: 'source $(basename "$0") <directory_path>'" >&2
  exit 1
fi

# Show usage if --help or -h is passed
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: source $(basename "$0") <directory_path>"
  echo "  <directory_path> : Sets fcHOME and defines sta/sto functions."
  echo "  No argument      : Unsets fcHOME and removes sta/sto functions."
  return 0
fi

# If no argument, clean environment and functions
if [ -z "$1" ]; then
  # Remove drivers/ctree.btrv from PATH and LD_LIBRARY_PATH if it was added
  if [ -n "$fcHOME" ]; then
    local _btrv_dir="$fcHOME/drivers/ctree.btrv"
    PATH=":$PATH:"
    PATH="${PATH//:$_btrv_dir:/}"
    PATH="${PATH#:}"
    PATH="${PATH%:}"
    export PATH
    LD_LIBRARY_PATH=":${LD_LIBRARY_PATH}:"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH//:$_btrv_dir:/}"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH#:}"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH%:}"
    export LD_LIBRARY_PATH
  fi
  unset fcHOME
  unset -f sta 2>/dev/null
  unset -f sto 2>/dev/null
  unset -f log 2>/dev/null
  unset _fc_log_pid
  unset _fc_server_pid
  unset _fc_log_owned
  echo "fcHOME, sta, sto, and log have been unset."
  return 0
fi

export fcHOME="$(cd "$1" && pwd)"

# Add drivers/ctree.btrv to PATH and LD_LIBRARY_PATH if it exists
if [ -d "$fcHOME/drivers/ctree.btrv" ]; then
  export PATH="$fcHOME/drivers/ctree.btrv:$PATH"
  export LD_LIBRARY_PATH="$fcHOME/drivers/ctree.btrv:$LD_LIBRARY_PATH"
fi

sta() {
  local do_clean=0
  local do_debug=0
  local do_log=0

  for arg in "$@"; do
    case "$arg" in
      c) do_clean=1 ;;
      d) do_debug=1 ;;
      l) do_log=1 ;;
      *) echo "sta: unknown parameter '$arg'" ;;
    esac
  done

  if [ "$do_clean" -eq 1 ]; then
    echo "Cleaning tranlogs/ ..."
    rm -rf "$fcHOME/tranlogs/"*

    echo "Cleaning data/ (keeping testdata/ and ctMonLayouts.json) ..."
    find "$fcHOME/data/" -mindepth 1 -maxdepth 1 \
      ! -name "testdata" \
      ! -name "ctMonLayouts.json" \
      -exec rm -rf {} +
  fi

  if [ "$do_debug" -eq 1 ]; then
    local vscode_dir="$HOME/_/.vscode"
    mkdir -p "$vscode_dir"
    local launch_file="$vscode_dir/launch.json"

    if [ -f "$launch_file" ] && command -v jq &>/dev/null; then
      # Update existing file: upsert the "Debug faircom" configuration in-place
      local tmp
      tmp=$(mktemp)
      jq --arg name    "Debug faircom ($fcHOME)" \
         --arg program "$fcHOME/server/faircom" \
         --arg cwd     "$fcHOME/server" \
         '
         (.configurations // []) as $cfgs |
         ([$cfgs[] | .name | startswith("Debug faircom")] | index(true)) as $idx |
         if $idx != null then
           .configurations[$idx] |= . + {name: $name, program: $program, cwd: $cwd}
         else
           .configurations += [{
             name: $name, type: "cppdbg", request: "launch",
             program: $program, args: [], stopAtEntry: false,
             cwd: $cwd, environment: [], externalConsole: false, MIMode: "gdb",
             setupCommands: [{description: "Enable pretty-printing for gdb",
               text: "-enable-pretty-printing", ignoreFailures: true}]
           }]
         end
         ' "$launch_file" > "$tmp" && mv "$tmp" "$launch_file"
    else
      # Create fresh
      cat > "$launch_file" <<EOF
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug faircom ($fcHOME)",
      "type": "cppdbg",
      "request": "launch",
      "program": "$fcHOME/server/faircom",
      "args": [],
      "stopAtEntry": false,
      "cwd": "$fcHOME/server",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
EOF
    fi
    echo "Updated '$launch_file' → target: $fcHOME/server/faircom"
    code "$HOME/_"
    return 0
  fi

  pushd "$fcHOME/" > /dev/null
  cd "./server"
  if [ "$do_log" -eq 1 ]; then
    log && _fc_log_owned=1
  fi
  ./faircom &
  _fc_server_pid=$!
  popd > /dev/null
}

sto() {
  tool ctstop -auto
  if [ -n "$_fc_log_owned" ] && [ -n "$_fc_log_pid" ] && kill -0 "$_fc_log_pid" 2>/dev/null; then
    if [ -n "$_fc_server_pid" ]; then
      echo "Waiting for faircom (PID $_fc_server_pid) to exit..."
      while kill -0 "$_fc_server_pid" 2>/dev/null; do
        sleep 0.5
      done
      unset _fc_server_pid
    fi
    kill "$_fc_log_pid"
    echo "Stopped log tail (PID $_fc_log_pid)."
    unset _fc_log_pid
    unset _fc_log_owned
  fi
}

log() {
  if [ -n "$_fc_log_pid" ] && kill -0 "$_fc_log_pid" 2>/dev/null; then
    echo "log: already tailing (PID $_fc_log_pid). Run 'kill $_fc_log_pid' to stop it first." >&2
    return 1
  fi
  local logfile="$fcHOME/data/CTSTATUS.FCS"
  if [ ! -f "$logfile" ]; then
    echo "Log file not found: $logfile" >&2
    return 1
  fi
  tail -f "$logfile" &
  _fc_log_pid=$!
  echo "Tailing '$logfile' in background (PID $_fc_log_pid). Run 'kill $_fc_log_pid' to stop."
}

tool() {
  local exe="$1"
  shift
  "$fcHOME/tools/$exe" "$@"
}

ctutil() {
  command ctutil "$@"
}


echo "fcHOME set to $fcHOME"
echo "Function 'sta' defined. Run 'sta' to start faircom in background (opts: c=clean, d=debug, l=log)."
echo "Function 'sto' defined. Run 'sto' to stop faircom automatically."
echo "Function 'log' defined. Run 'log' to tail \$fcHOME/data/CTSTATUS.FCS in background."
if [ -d "$fcHOME/drivers/ctree.btrv" ]; then
  echo "Added '$fcHOME/drivers/ctree.btrv' to PATH and LD_LIBRARY_PATH."
fi
